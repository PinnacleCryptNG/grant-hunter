# Required: Nebius Token Factory key (all LLM calls go through it)
NEBIUS_API_KEY=
# Required: Tavily web search key
TAVILY_API_KEY=
# Optional on Vercel: Postgres (Neon) connection string. Without it a local embedded Postgres (PGlite) in ./.data is used.
DATABASE_URL=
# Required for the scheduled hunt: Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Optional overrides
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-Nano-9B-v2
# NEMOTRON_SUPER_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
# NEMOTRON_ULTRA_MODEL=nvidia/Llama-3_1-Nemotron-Ultra-253B-v1
