# Required: Nebius Token Factory key (all LLM calls go through it)
NEBIUS_API_KEY=
# Required: Tavily web search key
TAVILY_API_KEY=
# Optional on Vercel: Postgres (Neon) connection string. Without it a local embedded Postgres (PGlite) in ./.data is used.
DATABASE_URL=
# Required for the scheduled hunt: Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Optional overrides
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
